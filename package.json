{
  "name": "terraform-template",
  "version": "1.0.0",
  "description": "Copies Terraform template files to /deploy",
  "main": "index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityofasheville/terraform_template.git"
  },
  "homepage": "https://github.com/cityofasheville/terraform_template.git#readme",
  "scripts": {
    "start": "node --env-file=.env src/local.js",
    "startpy": "python3 src/local.py",
    "clean": "rm -rf deploy/build && rm -rf node_modules",
    "deploy": "node deploy/deploy.js",
    "destroy": "node deploy/destroy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "yargs": "^18.0.0",
    "yaml": "^2.4.2"
  },
  "files": [
    "index.js",
    "cli.js",
    "lib/"
  ],
  "bin": {
    "terraform-template": "./cli.js"
  }
}
